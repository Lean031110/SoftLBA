# ============================================================
# SoftLBA — .env.docker.example
# ============================================================
# Configuración para despliegue con Docker.
# Copia este archivo como .env y configura los valores reales.
#
# USO:
#   cp .env.docker.example .env
#   # Edita .env con tus valores
#   docker compose up -d
# ============================================================

# --- Puertos externos ---
# Puerto del servidor web (Next.js)
WEB_PORT=3000
# Puerto del servicio realtime (Socket.IO)
REALTIME_PORT=3003
# Puerto del reverse proxy (Caddy)
CADDY_PORT=81

# --- Base de datos ---
# En Docker, la DB se guarda en un volumen persistente.
# No cambiar esta ruta — el entrypoint la gestiona.
DATABASE_URL=file:/app/db/custom.db

# --- Inicialización de DB ---
# true = ejecutar prisma db push + seed al arrancar
# false = saltar (para réplicas que comparten DB)
INIT_DB=true
# true = saltar seed aunque la DB esté vacía
SKIP_SEED=false

# --- Seguridad ---
# Genera con: openssl rand -hex 32
NEXTAUTH_SECRET=cambia-esto-en-produccion-minimo-16-chars
# Genera con: openssl rand -hex 32
REALTIME_SECRET=dev-internal-secret-change-in-prod

# --- Cookies ---
# En LAN HTTP: false
# En HTTPS producción: true
COOKIE_SECURE=false

# --- Configuración de usuarios demo ---
# En producción: false
DEMO_USERS=true

# --- Realtime Service ---
REALTIME_PORT=3003
# Orígenes permitidos para CORS (separados por coma)
# En producción: https://tu-dominio.com
# En LAN: http://tu-ip-local:81
ALLOWED_ORIGINS=

# --- Configuración LAN ---
# Si el servidor tiene IP pública, configura los orígenes permitidos arriba.
# El servicio realtime NO acepta tokens de query params (seguridad).
