# ============================================================
# SoftLBA — Caddyfile
# ============================================================
# Reverse proxy para SoftLBA.
#
# En Docker, Caddy se conecta al contenedor "softlba" por nombre.
# En bare-metal/systemd, usar "localhost" en vez de "softlba".
#
# Puerto :80 dentro del contenedor (mapeado a :81 externo en compose).
# Para HTTPS automático, cambiar ":80" por un dominio real:
#   midominio.com {
#     ...
#   }
# ============================================================

:80 {
	# Realtime is the only service exposed separately from Next.js.  The
	# destination is deliberately configured from the environment: request parameters must never select an
	# internal port (that would turn Caddy into an SSRF/open-proxy primitive).
	@realtime path /socket.io/*
	handle @realtime {
		reverse_proxy softlba:{env.REALTIME_PORT} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Fixed, read-only diagnostics. Request parameters never select an upstream.
	@realtimeHealth path /realtime-health
	handle @realtimeHealth {
		reverse_proxy softlba:{env.REALTIME_PORT}
	}
	@printWorkerHealth path /print-worker-health
	handle @printWorkerHealth {
		reverse_proxy softlba:{env.PRINT_WORKER_PORT}
	}

	# Proxy por defecto al servidor Next.js.
	handle {
		reverse_proxy softlba:{env.WEB_PORT} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
