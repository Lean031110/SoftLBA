# ============================================================
# SoftLBA — .env.example
# ============================================================
# Copia este archivo como .env y configura los valores reales.
# NUNCA subas .env al repositorio.
#
# Para configuración NO sensible (URLs, puertos, CORS) puedes usar
# config.json (copia config.example.json). Para secretos usa .env.
#
# Documentación completa: docs/CONFIGURACION.md

# === Base de datos ===
# SQLite (default): file:./db/custom.db
# PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=file:./db/custom.db

# === Secretos (OBLIGATORIOS en producción, >= 16 chars) ===
# Genera con: openssl rand -hex 32
NEXTAUTH_SECRET=cambia-esto-en-produccion-minimo-16-chars
REALTIME_SECRET=dev-internal-secret-change-in-prod

# === Cookies ===
# En LAN HTTP: COOKIE_SECURE=false
# En HTTPS producción: COOKIE_SECURE=true (default en prod)
COOKIE_SECURE=false

# === Backend ===
# Puerto del backend Next.js (default: 3000)
PORT=3000
# URL base del backend para server→server (default: http://localhost:3000)
# En producción: http://10.0.0.5:3000 o https://midominio.com
BACKEND_URL=http://localhost:3000

# === Realtime (Socket.IO) ===
# Puerto del servicio realtime (default: 3003)
REALTIME_PORT=3003
# URL interna del realtime para server→server (default: http://localhost:3003)
REALTIME_INTERNAL_URL=http://localhost:3003
# URL del endpoint /emit del realtime (default: ${REALTIME_INTERNAL_URL}/emit)
# REALTIME_EMIT_URL=http://localhost:3003/emit

# URL PÚBLICA del realtime para el browser (NEXT_PUBLIC_*)
# Vacía = el cliente usará la gateway con XTransformPort (sandbox).
# Para LAN directa: ws://10.0.0.5:3003
# Para HTTPS: wss://midominio.com/socket.io
# Para sandbox gateway: /?XTransformPort=3003
NEXT_PUBLIC_REALTIME_URL=/?XTransformPort=3003

# === Print Worker ===
# Puerto del Print Worker (default: 3004)
PRINT_WORKER_PORT=3004
# URL interna del Print Worker para server→server (default: http://localhost:3004)
PRINT_WORKER_URL=http://localhost:3004
# URL PÚBLICA del Print Worker para el browser (opcional, default: vía gateway)
# NEXT_PUBLIC_PRINT_WORKER_URL=http://10.0.0.5:3004
# Intervalo de procesamiento de cola en ms (default: 5000)
PRINT_WORKER_INTERVAL_MS=5000

# === Cliente (browser) ===
# URL pública del backend para el browser. Vacía = mismo origen (recomendado).
# NEXT_PUBLIC_BACKEND_URL=https://midominio.com

# === CORS — orígenes permitidos ===
# CSV: http://localhost:3000,http://10.0.0.5:3000
ALLOWED_ORIGINS=http://localhost:3000

# === Logging ===
# Niveles: DEBUG / INFO / WARN / ERROR / FATAL
# Console: en prod default INFO, en dev default DEBUG
# LOG_LEVEL_CONSOLE=INFO
# Archivos: default DEBUG (guarda todo)
# LOG_LEVEL_FILE=DEBUG
# Directorio de logs (default: ./logs)
# LOG_DIR=/var/log/softlba

# === Auth ===
# Duración de sesión en segundos (default: 43200 = 12h)
# SESSION_TTL_SECONDS=43200

# === Demo ===
# En producción: DEMO_USERS=false
# En desarrollo: DEMO_USERS=true (default)
DEMO_USERS=true

# === GitHub (para Update Manager futuro) ===
GITHUB_REPO=Lean031110/SoftLBA
GITHUB_CHANNEL=stable

# === Configuración de paths (opcional, defaults mostrados) ===
# APP_ROOT=/opt/softlba
# DATA_DIR=/opt/softlba/db
# BACKUP_DIR=/opt/softlba/backups
# RECEIPTS_DIR=/opt/softlba/download/comprobantes

# === Config.json (opcional, alternativa a .env para config no sensible) ===
# Path a config.json (default: ./config.json)
# CONFIG_PATH=/opt/softlba/config.json
