# ============================================================
# SoftLBA — .env.example
# ============================================================
# Copia este archivo como .env y configura los valores reales.
# NUNCA subas .env al repositorio.

# Base de datos (SQLite por defecto, migrable a PostgreSQL)
DATABASE_URL=file:./db/custom.db

# Perfil de despliegue: development | testing | lan | production
SOFTLBA_ENV=development
# Solo development: dominios de preview/HMR explícitamente permitidos (CSV).
# No usar en LAN ni production.
DEV_ALLOWED_ORIGINS=
# URL interna usada por procesos del servidor; nunca se expone al navegador.
APP_INTERNAL_URL=http://localhost:3000
# URL pública del backend/realtime para el navegador. En LAN/producción usar
# el dominio o IP LAN real, sin puertos internos ni query parameters.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_PATH=/socket.io

# Secreto de sesión (MÍNIMO 16 caracteres en producción)
# Genera uno con: openssl rand -hex 32
NEXTAUTH_SECRET=cambia-esto-en-produccion-minimo-16-chars

# Configuración de cookies
# En LAN HTTP: COOKIE_SECURE=false
# En HTTPS producción: COOKIE_SECURE=true
COOKIE_SECURE=false

# Servicio Realtime (Socket.IO)
# URL interna del servicio realtime (default: mismo host)
REALTIME_INTERNAL_URL=http://localhost:3000/api/internal/emit
# URL interna del endpoint /emit del servicio Socket.IO.
REALTIME_SERVICE_URL=http://localhost:3003/emit
# Secreto compartido entre Next.js y el servicio realtime
# Genera uno con: openssl rand -hex 32
REALTIME_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_BYTES

# Puerto del servicio realtime
REALTIME_PORT=3003

# Print worker (solo interno; no publicar este puerto a clientes).
PRINT_WORKER_PORT=3004
PRINT_WORKER_URL=http://localhost:3004
PRINT_WORKER_INTERVAL_MS=5000

# Puerto de Next.js; Caddy expone el sitio y enruta /socket.io a realtime.
WEB_PORT=3000

# Configuración de usuarios demo
# En producción: DEMO_USERS=false
# En desarrollo: DEMO_USERS=true (o comentar)
DEMO_USERS=true

# CORS — orígenes permitidos para Socket.IO
# Separar con comas: http://localhost:3000,http://192.168.1.100:3000
ALLOWED_ORIGINS=http://localhost:3000
# Orígenes de proxies inversos explícitamente confiables (CSV, opcional).
TRUSTED_PROXY_ORIGINS=

# GitHub (para Update Manager futuro)
GITHUB_REPO=Lean031110/SoftLBA
GITHUB_CHANNEL=stable

# Configuración de paths (opcional, defaults mostrados)
# APP_ROOT=/opt/softlba
# DATA_DIR=/opt/softlba/db
# BACKUP_DIR=/opt/softlba/backups
# RECEIPTS_DIR=/opt/softlba/download/comprobantes
